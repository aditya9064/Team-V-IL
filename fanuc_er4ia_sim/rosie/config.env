# AdaptiveVision on ROSIE: the only file you should need to edit.
# Values below match `./rosie/av.sh check` on Rosie; edit only if that output changes.

# --- Slurm (filled from `av.sh check` on 2026-10-15)
# Isaac Sim renders with RT cores. On Rosie only the T4 nodes have them;
# V100 (dgx) and H100 (dgxh100) cannot run Isaac rendering.
ISAAC_PARTITION="teaching"
ISAAC_GRES="gpu:t4:1"
ISAAC_CONSTRAINT=""
# Training runs on any CUDA GPU. H100 access confirmed 2026-10-15 (80 GB);
# fall back to "teaching" / "gpu:t4:1" if the dgxh100 queue is long.
TRAIN_PARTITION="dgxh100"
TRAIN_GRES="gpu:h100:1"
TRAIN_CONSTRAINT=""
ACCOUNT=""                   # leave empty unless your Slurm account must be named

# --- Storage (VERIFY: put data on the large scratch/data filesystem, not $HOME)
DATA_ROOT="$HOME/adaptivevision"   # /data and /scratch are read-only for students on Rosie

# --- Isaac Sim container (VERIFY tag on catalog.ngc.nvidia.com; starter was validated on 6.0)
ISAAC_IMAGE="docker://nvcr.io/nvidia/isaac-sim:6.0.0"
ISAAC_SIF="$DATA_ROOT/containers/isaac-sim.sif"
# Compute nodes without internet need a local robot asset; leave empty to use Isaac's asset root.
FANUC_ROBOT_USD=""

# --- Dataset size: NUM_CHUNKS x CHUNK_SIZE frames (default 10,000)
CHUNK_SIZE=500
NUM_CHUNKS=20
MAX_PARALLEL=4               # array tasks running at once; be fair to other users
SEED=20261015
GEN_TIME="08:00:00"
MIN_FRAMES=2000              # split refuses to train on fewer frames than this

# --- V2 dataset: hard cases (towers, clusters, arm, distractors, side/wrist views)
V2_SEED=20261016
V2_CHUNK_SIZE=500
V2_TABLE_CHUNKS=28           # chunks 0-27   table camera   (14,000 frames)
V2_SIDE_CHUNKS=6             # chunks 28-33  side camera    (3,000)
V2_WRIST_CHUNKS=6            # chunks 34-39  wrist camera   (3,000)
V2_TEST_COUNT=20             # frames per camera for the label check before the full run
V2_GPUS_PER_JOB=2            # Rosie caps running jobs (4), not GPUs: each job renders this many chunks at once.
                             # 2 schedules much sooner than 4 (needs a fully free node) on the shared T4s.

# --- Training
TRAIN_TIME="23:50:00"         # Rosie student QOS max is 1 day; v2 sets need it
WATCH_TIME="23:50:00"         # Rosie student QOS caps jobs at 1 day
WATCH_RENEW_AFTER=84600      # seconds (23.5 h): then the watchdog submits its successor
PYTHON_VERSION="3.12"

# --- GB10 (spark1) baseline: Rosie pushes trained models there and scores them vs Cosmos
GB10_HOST="hackathon1@spark1.ai.msoe.edu"
GB10_KEY="$HOME/.ssh/av_gb10"   # Rosie-only key; revoke by deleting its line in the GB10 authorized_keys
GB10_DIR="adaptivevision"       # relative to the GB10 home

# --- Notifications: your email, to get a message if any stage fails and when results are ready
MAIL_USER=""                 # optional: your email for Slurm job mails
